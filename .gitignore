# .gitignore — KUSOR v3

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/
*.env
!*.env.example

# Node / Angular Frontend
**/node_modules/
**/dist/
**/.angular/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Runtime Data
*.sqlite
*.sqlite3
*.db
backend/data/
training/data/
*.log

# Large Model Binaries & Weights
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx

# IDEs & System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.tmp
