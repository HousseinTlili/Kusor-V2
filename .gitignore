# .gitignore — KUSOR v3

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
env/
ENV/
*.env
!*.env.example

# Process IDs & Local Logs
*.pid
.backend.pid
.frontend.pid
*.log
backend.log
/tmp/

# Documentation & Internal Reports
PROJECT_STATUS.md
TECHNICAL_HANDOFF.md
.agents/

# Node / Angular Frontend
**/node_modules/
**/dist/
**/.angular/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & Local Runtime Storage
*.sqlite
*.sqlite3
*.db
backend/data/uploads/
backend/data/bm25_index.pkl
backend/data/sanctions/

# Large Model Binaries, Weights & LoRA Checkpoints
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.onnx
training/output/
training/output/*

# IDEs & System Caches
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
*.tmp
