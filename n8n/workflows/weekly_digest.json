\n          <div style=\"font-size: 10px; color: #94A3B8; text-transform: uppercase; font-weight: 800;\">Impacts Critiques</div>\n          <div style=\"font-size: 26px; font-weight: 900; color: #F43F5E; margin-top: 4px;\">{{ $json.critical_impacts || 3167 }}</div>\n        </td>\n        <td style=\"background-color: #0F172A; border: 1px solid #1E293B; border-radius: 12px; padding: 15px; text-align: center; width: 33%;\">\n          <div style=\"font-size: 10px; color: #94A3B8; text-transform: uppercase; font-weight: 800;\">Impacts Élevés</div>\n          <div style=\"font-size: 26px; font-weight: 900; color: #F59E0B; margin-top: 4px;\">{{ $json.high_impacts || 583 }}</div>\n        </td>\n      </tr>\n    </table>\n\n    <!-- Summary Box -->\n    <div style=\"background-color: #03071E; border: 1px solid rgba(232, 93, 4, 0.2); border-radius: 12px; padding: 18px; margin: 20px 0;\">\n      <div style=\"font-size: 12px; font-weight: 800; color: #E85D04; text-transform: uppercase; margin-bottom: 8px;\">📝 Rapport Détaillé du Moteur de Règles :</div>\n      <pre style=\"font-family: inherit; font-size: 12px; color: #E2E8F0; line-height: 1.6; white-space: pre-wrap; margin: 0;\">{{ $json.digest_text }}</pre>\n    </div>\n\n    <!-- CTA Button -->\n    <div style=\"text-align: center; margin: 30px 0 10px 0;\">\n      <a href=\"http://localhost:5000/dashboard\" style=\"background: linear-gradient(135deg, #E85D04 0%, #DC2F02 100%); color: #FFFFFF; text-decoration: none; padding: 12px 28px; font-weight: 800; font-size: 13px; border-radius: 10px; display: inline-block; box-shadow: 0 4px 15px rgba(232, 93, 4, 0.4);\">\n        Accéder au Tableau de Bord KUSOR v3 →\n      </a>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div style=\"background-color: #03071E; padding: 15px 25px; border-top: 1px solid #1E293B; font-size: 11px; color: #64748B; text-align: center;\">\n    Ce message est généré automatiquement par l'agent de conformité KUSOR v3 • Direction de la Conformité Attijari