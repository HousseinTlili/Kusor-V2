cular_ref}}</td>\n      </tr>\n      <tr style=\"border-bottom: 1px solid #1E293B;\">\n        <td style=\"padding: 10px 0; color: #94A3B8; font-weight: 700;\">Processus / Contrats Impactés :</td>\n        <td style=\"padding: 10px 0; color: #F59E0B; font-weight: 800;\">{{$json.body.affected_count || $json.body.total_affected || 1}} élément(s) affecté(s)</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 10px 0; color: #94A3B8; font-weight: 700;\">Origine des Données :</td>\n        <td style=\"padding: 10px 0; color: #E85D04; font-weight: 700;\">{{$json.body.source || 'Portail Banque Centrale de Tunisie'}}</td>\n      </tr>\n    </table>\n\n    <!-- Summary Box -->\n    <div style=\"background-color: #03071E; border: 1px solid #1E293B; border-radius: 12px; padding: 18px; margin: 20px 0;\">\n      <div style=\"font-size: 11px; font-weight: 800; color: #F43F5E; text-transform: uppercase; margin-bottom: 6px;\">Description de l'Impact :</div>\n      <p style=\"font-size: 13px; line-height: 1.6; color: #E2E8F0; margin: 0;\">{{ $json.body.summary }}</p>\n    </div>\n\n    <!-- Action Button -->\n    <div style=\"text-align: center; margin: 30px 0 10px 0;\">\n      <a href=\"http://localhost:4200/impact-viewer/{{$json.body.circular_number || $json.body.circular_ref}}\" style=\"background: linear-gradient(135deg, #E11D48 0%, #BE123C 100%); color: #FFFFFF; text-decoration: none; padding: 12px 28px; font-weight: 800; font-size: 13px; border-radius: 10px; display: inline-block; box-shadow: 0 4px 15px rgba(225, 29, 72, 0.4);\">\n        Visualiser l'Arbre d'Impact (Graph Viewer) →\n      </a>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <div style=\"background-color: #03071E; padding: 15px 25px; border-top: 1px solid #1E293B; font-size: 11px; color: #64748B; text-align: center;\">\n    Notification prioritaire émise par le système KUSOR v3 • Direction de la Conformité Attijari Bank Tunisia\n  </div>\n</div>"
