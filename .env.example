# .env.example
# KUSOR v3 — Environment Variables
# Copy to .env and fill in production values
# ─────────────────────────────────────────────

# ── Flask ────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# ── JWT Authentication ───────────────────────────────
JWT_SECRET_KEY=change-me-to-a-different-random-string
JWT_ACCESS_TOKEN_EXPIRES=604800   # 7 days in seconds

# ── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://kusor_user:kusor_password@localhost:5432/kusor_db

# ── Neo4j ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=kusor_password

# ── ChromaDB ─────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=kusor_v3_docs

# ── Ollama ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# ── BCT Scraper ──────────────────────────────────────
BCT_BASE_URL=https://www.bct.gov.tn
BCT_CIRCULARS_URL=https://www.bct.gov.tn/bct/siteprod/tableau_circulaires.jsp
SCRAPE_INTERVAL_HOURS=24

# ── File Storage ─────────────────────────────────────
UPLOAD_FOLDER=backend/data/uploads
MAX_CONTENT_LENGTH=52428800   # 50 MB

# ── BM25 Index ───────────────────────────────────────
BM25_INDEX_PATH=backend/data/bm25_index.pkl

# ── Sanctions Lists (for KYC module) ────────────────
SANCTIONS_DIR=backend/data/sanctions

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
